import cv2
import time
import os
import RPi.GPIO as GPIO  # For GPIO control on Raspberry Pi

# GPIO setup
GPIO.setmode(GPIO.BCM)  # Use BCM pin numbering
GPIO.setwarnings(False)  # Disable GPIO warnings

# Define GPIO pins
RELAY_LED = 5     # Relay for LED
RELAY_CAMERA = 23 # Relay for Camera

# Set both relays as output
GPIO.setup(RELAY_LED, GPIO.OUT)
GPIO.setup(RELAY_CAMERA, GPIO.OUT)

# Turn ON LED relay (GPIO 5) at the start
GPIO.output(RELAY_LED, GPIO.HIGH)
print("LED Relay ON (GPIO 5) - Light is ON")

# Turn ON Camera relay (GPIO 23) at the start
GPIO.output(RELAY_CAMERA, GPIO.HIGH)
print("Camera Relay ON (GPIO 23) - Camera is powered ON")

# Specify the full paths to the Haar cascade XML files
current_dir = os.path.dirname(os.path.abspath(__file__))
face_cascade_path = os.path.join(current_dir, 'haarcascade_frontalface_default.xml')
smile_cascade_path = os.path.join(current_dir, 'haarcascade_smile.xml')

# Load the pre-trained Haar cascades for face and smile detection
face_cascade = cv2.CascadeClassifier(face_cascade_path)
smile_cascade = cv2.CascadeClassifier(smile_cascade_path)

# Start video capture from the webcam
video_capture = cv2.VideoCapture(0)

# Retry logic to handle camera initialization issues
retry_count = 0
while not video_capture.isOpened() and retry_count < 5:
    print("Failed to open camera. Retrying...")
    time.sleep(1)
    video_capture = cv2.VideoCapture(0)
    retry_count += 1

if not video_capture.isOpened():
    print("Unable to access the camera after multiple attempts.")
    GPIO.cleanup()  # Cleanup GPIO before exiting
    exit()  # Exit the program if the camera is not accessible

# Initialize a flag to track smile detection and a cooldown timer
cooldown = 15  # Cooldown time in seconds
last_smile_time = time.time() - cooldown  # Set the initial value to allow immediate detection

while True:
    # Capture frame-by-frame
    ret, frame = video_capture.read()

    if not ret:
        print("Failed to capture video")
        break

    # Convert the frame to grayscale (better for Haar Cascades)
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # Detect faces in the frame
    faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5, minSize=(30, 30))

    # Loop through the detected faces
    for (x, y, w, h) in faces:
        # Draw a rectangle around the face
        cv2.rectangle(frame, (x, y), (x + w, y + h), (255, 0, 0), 2)

        # Focus on the face area for smile detection
        face_gray = gray[y:y + h, x:x + w]

        # Detect smiles within the face area
        smiles = smile_cascade.detectMultiScale(face_gray, scaleFactor=1.8, minNeighbors=20, minSize=(25, 25))

        # Get the current time
        current_time = time.time()

        # If a smile is detected and the cooldown period has passed
        if len(smiles) > 0 and (current_time - last_smile_time) > cooldown:
            print("Smile detected!")

            last_smile_time = current_time  # Update the last smile detection time

        # Draw rectangles around the detected smiles
        for (sx, sy, sw, sh) in smiles:
            cv2.rectangle(frame[y:y + h, x:x + w], (sx, sy), (sx + sw, sy + sh), (0, 255, 0), 2)

    # Display the resulting frame
    cv2.imshow('Smile Detection', frame)

    # Break the loop if 'q' is pressed
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Release the capture and close the OpenCV windows
video_capture.release()
cv2.destroyAllWindows()

# Turn off the Camera relay before exiting
GPIO.output(RELAY_CAMERA, GPIO.LOW)
print("Camera Relay OFF (GPIO 23) - Camera turned OFF")

# LED stays ON even after script exit
print("LED remains ON (GPIO 5)")

# Clean up GPIO resources
GPIO.cleanup()
